# ---------------------------------------------------------------------------
# TheNewsAPI.com API token  (REQUIRED for both stdio and HTTP modes)
# Get one by creating a free account at https://www.thenewsapi.com/register
# then copy the token from https://www.thenewsapi.com/account/dashboard
#
# Copy this file to `.env` and fill in your real token. `.env` is gitignored;
# this .example file is committed, so never put a real token here.
# ---------------------------------------------------------------------------
NEWS_API_TOKEN=your_thenewsapi_token_here

# ---------------------------------------------------------------------------
# Streamable HTTP mode only  (dist/http.js / `npm run start:http`)
# Ignored by the stdio entrypoint.
# ---------------------------------------------------------------------------

# Shared secret remote clients (e.g. SecureAI / HatzAI) must present, as either:
#   Authorization: Bearer <token>      (client auth method: "Bearer Token")
#   X-API-Key: <token>                 (client auth method: "API Key")
# Leave BLANK to disable auth (client auth method: "None") — only safe if the
# endpoint is not reachable from the internet.
MCP_AUTH_TOKEN=

# Header name to accept for "API Key" style auth (default: x-api-key).
# MCP_API_KEY_HEADER=x-api-key

# Listen port / bind address / route. Default host is loopback — run a TLS
# reverse proxy (Cloudways domain, Nginx, etc.) in front and leave it on 127.0.0.1.
# MCP_HTTP_PORT=3000
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PATH=/mcp

# Set to an origin (or "*") to emit CORS headers for browser-based MCP clients.
# MCP_CORS_ORIGIN=*
