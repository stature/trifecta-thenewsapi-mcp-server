# /etc/systemd/system/thenewsapi-mcp.service
#
# Runs the Streamable HTTP MCP server as an unprivileged, auto-restarting service.
# Assumes the build lives at /opt/thenewsapi-mcp with a dedicated `mcp` user and
# an /opt/thenewsapi-mcp/.env file (chmod 600, owned by mcp).

[Unit]
Description=TheNewsAPI MCP server (Streamable HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp
Group=mcp
WorkingDirectory=/opt/thenewsapi-mcp
EnvironmentFile=/opt/thenewsapi-mcp/.env
ExecStart=/usr/bin/node /opt/thenewsapi-mcp/dist/http.js
Restart=on-failure
RestartSec=3

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
