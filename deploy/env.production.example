# Copy to /opt/thenewsapi-mcp/.env on the server, fill in real values, then:
#   sudo chown mcp:mcp /opt/thenewsapi-mcp/.env && sudo chmod 600 /opt/thenewsapi-mcp/.env
#
# systemd reads this file directly (EnvironmentFile=), so: KEY=value only,
# no `export`, no surrounding quotes, no $(...) command substitution.

# --- required ---
NEWS_API_TOKEN=your_thenewsapi_token_here

# Shared secret remote clients (SecureAI/HatzAI) must send as
#   Authorization: Bearer <token>    or    X-API-Key: <token>
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=paste_a_64_char_hex_string_here

# --- networking (Caddy terminates TLS and proxies to this) ---
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

# --- optional ---
# MCP_API_KEY_HEADER=x-api-key
# MCP_CORS_ORIGIN=*
